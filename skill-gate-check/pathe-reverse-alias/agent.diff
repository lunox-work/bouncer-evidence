+/**
+ * Reverse of {@link resolveAlias}: returns every alias form that resolves to the given path.
+ * Results are ordered from most specific alias to least specific. If no alias target
+ * contains the path, the normalised path itself is returned as the only entry.
+ *
+ * @param path - The path to reverse-resolve.
+ * @param aliases - A set of alias mappings to use for resolution.
+ * @returns the list of alias paths that resolve to `path`.
+ */
+export function reverseResolveAlias(
+  path: string,
+  aliases: Record<string, string>,
+): string[] {
+  const _path = normalizeWindowsPath(path);
+  const _aliases = normalizeAliases(aliases);
+  const matches = new Set<string>();
+  for (const [alias, to] of Object.entries(_aliases)) {
+    // Strip trailing slash from target for check
+    const _to = hasTrailingSlash(to) ? to.slice(0, -1) : to;
+    if (!_path.startsWith(_to) || !pathSeparators.has(_path[_to.length])) {
+      continue;
+    }
+    matches.add(join(alias, _path.slice(_to.length)));
+  }
+  return matches.size > 0 ? [...matches] : [_path];
+}
