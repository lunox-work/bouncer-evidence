+import { describe, expect, it } from "vitest";
+
+import { reverseResolveAlias, resolveAlias } from "../src/utils";
+
+describe("reverseResolveAlias", () => {
+  const aliases = {
+    "@": "/root",
+    "~": "/root/index.js",
+    "~/": "/src",
+    "~assets": "/root/some/dir",
+    "~win": "C:/root/index.js",
+    "~win/": "C:/src",
+  };
+
+  it("returns the alias form for a path under the target", () => {
+    expect(reverseResolveAlias("/root/foo/bar.js", aliases)).toEqual([
+      "@/foo/bar.js",
+    ]);
+  });
+
+  it("returns all matching aliases, most specific first", () => {
+    const result = reverseResolveAlias("/root/some/dir/smth.jpg", {
+      "~": "/root",
+      "~/assets": "/root/some/dir",
+    });
+    expect(result).toEqual(["~/assets/smth.jpg", "~/some/dir/smth.jpg"]);
+  });
+
+  it("respects path separators", () => {
+    expect(reverseResolveAlias("/rootfoo/bar.js", { "@": "/root" })).toEqual([
+      "/rootfoo/bar.js",
+    ]);
+  });
+
+  it("returns the normalised path when nothing matches", () => {
+    expect(reverseResolveAlias("foo\\bar.js", aliases)).toEqual(["foo/bar.js"]);
+    expect(reverseResolveAlias("./bar.js", aliases)).toEqual(["./bar.js"]);
+  });
+
+  it("normalises windows paths", () => {
+    expect(reverseResolveAlias("C:\\root\\index.js", aliases)).toEqual([
+      "~win",
+    ]);
+  });
+
+  it("round-trips with resolveAlias", () => {
+    const paths = ["/root/foo/bar.js", "/src/foo/bar", "/root/some/dir/x.ts"];
+    for (const p of paths) {
+      for (const alias of reverseResolveAlias(p, aliases)) {
+        expect(resolveAlias(alias, aliases)).toBe(p);
+      }
+    }
+  });
+});
