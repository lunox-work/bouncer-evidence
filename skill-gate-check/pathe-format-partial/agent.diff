+import { describe, expect, it } from "vitest";
+
+import { format } from "../src";
+
+describe("format with partial arguments", () => {
+  const cases: [Record<string, string | undefined>, string][] = [
+    // Only `name`, no `ext`
+    [{ name: "file" }, "file"],
+    // Only `ext`, no `name`
+    [{ ext: ".txt" }, ".txt"],
+    // Only `dir`, no `base`/`name`/`ext`
+    [{ dir: "/home/user" }, "/home/user"],
+    // Only `root`
+    [{ root: "/" }, "/"],
+    // Empty object
+    [{}, ""],
+    // `dir` and `name`, no `ext`
+    [{ dir: "/home/user", name: "file" }, "/home/user/file"],
+    // `root` and `ext`, no `name`
+    [{ root: "/", ext: ".txt" }, "/.txt"],
+    // `base` takes precedence over `name`/`ext` even when partial
+    [{ base: "file.txt", name: "other" }, "file.txt"],
+    // `undefined` values are the same as missing ones
+    [{ name: undefined, ext: ".txt", dir: undefined }, ".txt"],
+    // Empty string base falls through to nothing
+    [{ base: "", dir: "/home/user" }, "/home/user"],
+  ];
+
+  for (const [input, expected] of cases) {
+    it(`format(${JSON.stringify(input)}) should be ${JSON.stringify(expected)}`, () => {
+      expect(format(input as any)).to.equal(expected);
+    });
+  }
+
+  it("never produces the string 'undefined'", () => {
+    expect(format({ name: "file" } as any)).not.toContain("undefined");
+    expect(format({ ext: ".txt" } as any)).not.toContain("undefined");
+    expect(format({} as any)).not.toContain("undefined");
+  });
+
+  it("keeps full-argument behavior unchanged", () => {
+    expect(
+      format({ dir: "/home/user", name: "file", ext: ".txt" } as any),
+    ).to.equal("/home/user/file.txt");
+    expect(format({ root: "/", name: "file", ext: ".txt" } as any)).to.equal(
+      "/file.txt",
+    );
+  });
+});
