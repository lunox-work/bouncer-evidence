@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { resolve } from "../src/index";
+
+describe("resolve UNC", () => {
+  const cases: [string[], string][] = [
+    [["//server/share/file", "../path"], "//server/share/path"],
+    [[String.raw`\\server\share\file`, String.raw`..\path`], "//server/share/path"],
+    [[String.raw`\\server\share`], "//server/share/"],
+    [["//server/share/", "a"], "//server/share/a"],
+    [["//server/share/..", "x"], "//server/share/x"],
+    [["//server/share/a", "/b"], "/b"],
+    [["/foo", "//server/share/x"], "//server/share/x"],
+    [["//./c:/temp/file", String.raw`..\path`], "//./c:/temp/path"],
+    [["//a/b", "c", "..", "d"], "//a/b/d"],
+  ];
+  for (const [args, expected] of cases) {
+    it(`resolve(${args.join(",")}) = ${expected}`, () => {
+      expect(resolve(...args)).toBe(expected);
+    });
+  }
+});
